{
  "manifest_version": 3,
  "name": "Extensão IFTO Palmas",
  "short_name": "IFTO Palmas",
  "version": "0.1.1",
  "description": "Melhorias no SEI e apoio ao Sistema de Gestão Orçamentária do IFTO Campus Palmas.",
  "icons": { "48": "icones/icone.svg", "96": "icones/icone.svg" },
  "permissions": ["storage"],
  "host_permissions": ["*://*.ifto.edu.br/*controlador.php?acao=*", "*://*.ifto.edu.br/*login.php*"],
  "action": {
    "default_icon": "icones/icone.svg",
    "default_title": "Extensão IFTO Palmas",
    "default_popup": "janela/index.html"
  },
  "options_ui": {
    "page": "configuracoes/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.ifto.edu.br/*controlador.php?acao=*"],
      "run_at": "document_idle",
      "js": ["comum/sei.js", "sites/sei/todas-as-paginas.js"]
    },
    {
      "matches": ["*://*.ifto.edu.br/*controlador.php?acao=arvore_visualizar*"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["comum/sei.js", "comum/configuracoes.js", "sites/sei/botao-novo-documento.js"]
    },
    {
      "matches": [
        "*://*.ifto.edu.br/*login.php*",
        "*://*.ifto.edu.br/*controlador.php?acao=documento_assinar*"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["comum/sei.js", "comum/configuracoes.js", "sites/sei/campo-senha.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extensao-ifto@palmas.ifto.edu.br",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}

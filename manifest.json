{
  "manifest_version": 3,
  "name": "Extensão IFTO Palmas",
  "short_name": "IFTO Palmas",
  "version": "0.10.0",
  "description": "Melhorias no SEI e apoio ao Sistema de Gestão Orçamentária do IFTO Campus Palmas.",
  "icons": { "48": "icones/icone.svg", "96": "icones/icone.svg" },
  "permissions": ["storage"],
  "host_permissions": ["*://sei.ifto.edu.br/*controlador.php?acao=*", "*://sei.ifto.edu.br/*login.php*"],
  "action": {
    "default_icon": "icones/icone.svg",
    "default_title": "Extensão IFTO Palmas",
    "default_popup": "janela/index.html"
  },
  "options_ui": {
    "page": "configuracoes/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://sei.ifto.edu.br/*controlador.php?acao=*"],
      "run_at": "document_idle",
      "js": [
        "comum/sei.js",
        "comum/configuracoes.js",
        "comum/lista-assinaturas.js",
        "comum/documento-externo.js",
        "comum/documentos-pagamento.js",
        "comum/sicaf.js",
        "sites/sei/todas-as-paginas.js",
        "sites/sei/barra-extensao.js",
        "sites/sei/sei-pedidos.js",
        "sites/sei/pdf-texto.js",
        "sites/sei/lista-assinaturas.js",
        "sites/sei/documentos-pagamento.js",
        "sites/sei/sicaf.js"
      ]
    },
    {
      "matches": ["*://sei.ifto.edu.br/*controlador.php?acao=*"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["sites/sei/lista-assinaturas-teclas.js"]
    },
    {
      "matches": ["*://sei.ifto.edu.br/*controlador.php?acao=documento_receber*"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["comum/configuracoes.js", "comum/documento-externo.js", "sites/sei/documento-externo.js"]
    },
    {
      "matches": [
        "*://sei.ifto.edu.br/*login.php*",
        "*://sei.ifto.edu.br/*controlador.php?acao=documento_assinar*"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["comum/sei.js", "comum/configuracoes.js", "sites/sei/campo-senha.js"]
    },
    {
      "matches": ["*://sei.ifto.edu.br/*controlador.php?acao=documento_assinar*"],
      "run_at": "document_idle",
      "all_frames": true,
      "js": ["sites/sei/assinar-e-proximo.js"]
    }
  ],
  "web_accessible_resources": [
    { "resources": ["bibliotecas/pdfjs/*.mjs"], "matches": ["*://sei.ifto.edu.br/*"] }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extensao-ifto@palmas.ifto.edu.br",
      "update_url": "https://github.com/gvtenberg/extensao-ifto/releases/latest/download/updates.json",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
